class MerchantHandler : HDCoreEventHandler {

	private int MoneyMode;
	private bool SpawnedTiberium;

	Array<HDMerchantSkin> Skins;
	Array<name> NonBountyBlacklist;

	override void beforeProcessCommands() {
		BountyTargets.clear();
		NonBountyBlacklist.clear();
		SafeMapNames.clear();
		Skins.clear();
		StoreCurrencies.clear();
		StoreItems.clear();

		StoreTypes = MerchantStoreTable.create();

		initBounties();
		initCurrencies();
		initStores();
	}

	override void processCommand(HDCoreCommand cmd) {
		switch (cmd.command) {
			case 'configureMerchants':
				processConfigureMerchantsCmd(cmd);
				break;
			case 'newMerchantBountyTarget':
				processNewMerchantBountyTargetCmd(cmd);
				break;
			case 'removeMerchantBountyTarget':
				processRemoveMerchantBountyTargetCmd(cmd);
				break;
			case 'clearMerchantBountyTargets':
				processClearMerchantBountyTargetsCmd(cmd);
				break;
			case 'addMerchantNonBountyBlacklist':
				processAddMerchantNonBountyBlacklistCmd(cmd);
				break;
			case 'removeMerchantNonBountyBlacklist':
				processRemoveMerchantNonBountyBlacklistCmd(cmd);
				break;
			case 'clearMerchantNonBountyBlacklist':
				processClearMerchantNonBountyBlacklistCmd(cmd);
				break;
			case 'addMerchantSafeMap':
				processAddMerchantSafeMapCmd(cmd);
				break;
			case 'removeMerchantSafeMap':
				processRemoveMerchantSafeMapCmd(cmd);
				break;
			case 'clearMerchantSafeMaps':
				processClearMerchantSafeMapsCmd(cmd);
				break;
			case 'newMerchantSkin':
				processNewMerchantSkinCmd(cmd);
				break;
			case 'removeMerchantSkin':
				processRemoveMerchantSkinCmd(cmd);
				break;
			case 'clearMerchantSkins':
				processClearMerchantSkinsCmd(cmd);
				break;
			case 'newMerchantStore':
				processNewMerchantStoreCmd(cmd);
				break;
			case 'removeMerchantStore':
				processRemoveMerchantStoreCmd(cmd);
				break;
			case 'clearMerchantStores':
				processClearMerchantStoresCmd(cmd);
				break;
			case 'addMerchantStoreSkin':
				processAddMerchantStoreSkinCmd(cmd);
				break;
			case 'newMerchantStoreCurrency':
				processNewMerchantStoreCurrencyCmd(cmd);
				break;
			case 'removeMerchantStoreCurrency':
				processRemoveMerchantStoreCurrencyCmd(cmd);
				break;
			case 'clearMerchantStoreCurrencies':
				processClearMerchantStoreCurrenciesCmd(cmd);
				break;
			case 'newMerchantStoreItem':
				processNewMerchantStoreItemCmd(cmd);
				break;
			case 'removeMerchantStoreItem':
				processRemoveMerchantStoreItemCmd(cmd);
				break;
			case 'clearMerchantStoreItems':
				processClearMerchantStoreItemsCmd(cmd);
				break;
			default:
				break;
		}
	}

	void processConfigureMerchantsCmd(HDCoreCommand cmd) {

		HDCore.log('Merchant.MerchantHandler', LOGGING_DEBUG, "Processing Configure Merchants Command: "..cmd.toString());

		if (cmd.getBoolParam("clean")) {
			processClearMerchantBountyTargetsCmd(cmd);
			processClearMerchantNonBountyBlacklistCmd(cmd);
			processClearMerchantSafeMapsCmd(cmd);
			processClearMerchantSkinsCmd(cmd);
			processClearMerchantStoresCmd(cmd);
			processClearMerchantStoreCurrenciesCmd(cmd);
			processClearMerchantStoreItemsCmd(cmd);
		}

		Array<name> namesArr;

		// Add all configured Map Blacklist Entries
		cmd.getArrayNameParam("nonBountyBlacklist", namesArr);
		forEach (name : namesArr) addNonBountyBlacklist(name);

		// Add all configured Thing Blacklist Entries
		cmd.getArrayNameParam("safeMaps", namesArr);
		forEach (name : namesArr) addSafeMapName(name);

		Array<string> jsonArr;
		
		// Add all configured Bounty Targets
		cmd.getArrayStringParam("bountyTargets", jsonArr);
		forEach (str : jsonArr) {

			let json = HDZJSON.parse(str);

			if (!(json is 'HDZJsonObject')) {
				if (json is 'HDZJsonError') {
					HDCore.log('Merchant.MerchantHandler', LOGGING_ERROR, HDZJsonError(json).what);
				} else {
					HDCore.log('Merchant.MerchantHandler', LOGGING_ERROR, "Invalid Bounty Target Config: "..HDZJsonElement(json).serialize());
				}

				continue;
			}

			// Create Bounty Target itself
			processNewMerchantBountyTargetCmd(HDCoreCommand.create('newMerchantBountyTarget', HDZJsonObject(json).serialize()));
		}
		
		// Add all configured Merchant Currencies
		cmd.getArrayStringParam("currencies", jsonArr);
		forEach (str : jsonArr) {

			let json = HDZJSON.parse(str);

			if (!(json is 'HDZJsonObject')) {
				if (json is 'HDZJsonError') {
					HDCore.log('Merchant.MerchantHandler', LOGGING_ERROR, HDZJsonError(json).what);
				} else {
					HDCore.log('Merchant.MerchantHandler', LOGGING_ERROR, "Invalid Currency Config: "..HDZJsonElement(json).serialize());
				}

				continue;
			}

			// Create Currency itself
			processNewMerchantStoreCurrencyCmd(HDCoreCommand.create('newMerchantStoreCurrency', HDZJsonObject(json).serialize()));
		}

		// Add all configured Merchant Skins
		cmd.getArrayStringParam("skins", jsonArr);
		forEach (str : jsonArr) {

			let json = HDZJSON.parse(str);

			if (!(json is 'HDZJsonObject')){
				if (json is 'HDZJsonError') {
					HDCore.log('Merchant.MerchantHandler', LOGGING_ERROR, HDZJsonError(json).what);
				} else {
					HDCore.log('Merchant.MerchantHandler', LOGGING_ERROR, "Invalid Merchant Skin Config: "..HDZJsonElement(json).serialize());
				}

				continue;
			}

			// Create Merchant Skin itself
			processNewMerchantSkinCmd(HDCoreCommand.create('newMerchantSkin', HDZJsonObject(json).serialize()));
		}

		// Add all configured Merchant Store Entries
		cmd.getArrayStringParam("stores", jsonArr);
		forEach (str : jsonArr) {

			let json = HDZJSON.parse(str);

			if (!(json is 'HDZJsonObject')){
				if (json is 'HDZJsonError') {
					HDCore.log('Merchant.MerchantHandler', LOGGING_ERROR, HDZJsonError(json).what);
				} else {
					HDCore.log('Merchant.MerchantHandler', LOGGING_ERROR, "Invalid Merchant Store Config: "..HDZJsonElement(json).serialize());
				}

				continue;
			}

			let obj = HDZJsonObject(json);

			// If type isn't a valid string, skip.
			if (!(obj.get("type") is 'HDZJsonString')) continue;

			// Create Spawn Table itself
			processNewMerchantStoreCmd(HDCoreCommand.create('newMerchantStore', obj.serialize()));

			let storeType = obj.get("type");

			if (obj.get("categories") is 'HDZJsonArray') {
				forEach (category : HDZJsonArray(obj.get("categories")).arr) {

					if (!(category is 'HDZJsonObject')){
						if (category is 'HDZJsonError') {
							HDCore.log('Merchant.MerchantHandler', LOGGING_ERROR, HDZJsonError(category).what);
						} else {
							HDCore.log('Merchant.MerchantHandler', LOGGING_ERROR, "Invalid Spawn Table Config: "..HDZJsonElement(category).serialize());
						}

						continue;
					}

					let catObj = HDZJsonObject(category);

					// If category name isn't a valid string, skip.
					if (!(catObj.get("name") is 'HDZJsonString')) continue;

					let storeCat = catObj.get("name");

					if (catObj.get("items") is 'HDZJsonArray') {

						forEach(entry : HDZJsonArray(catObj.get("items")).arr) {

							if (!(entry is 'HDZJsonObject')){
								if (entry is 'HDZJsonError') {
									HDCore.log('Merchant.MerchantHandler', LOGGING_ERROR, HDZJsonError(entry).what);
								} else {
									HDCore.log('Merchant.MerchantHandler', LOGGING_ERROR, "Invalid Spawn Table Config: "..HDZJsonElement(entry).serialize());
								}

								continue;
							}

							let entryObj = HDZJsonObject(entry);
							
							entryObj.set("type", storeType);
							entryObj.set("category", storeCat);

							processNewMerchantStoreItemCmd(HDCoreCommand.create('newMerchantStoreItem', entryObj.serialize()));
						}
					}
				}
			}
		}
	}

	void processNewMerchantBountyTargetCmd(HDCoreCommand cmd) {

		HDCore.log('Merchant.MerchantHandler', LOGGING_DEBUG, "Processing New Merchant Bounty Target Command: "..cmd.toString());

		// Get Target's ClassName and check if it's valid
		let name = cmd.getNameParam("name");
		Class<Actor> cls = name;

		// If the target's class doesn't exist, quit.
		if (!cls) return;

		// get remaining params
		let effect = cmd.getNameParam("effect");
		let value = cmd.getIntParam("value");

		// Look for existing bounty target definitions
		BountyTarget existingTarget;
		forEach (t : BountyTargets) {
			if (t.targetCls == name) {
				existingTarget = t;
				break;
			}
		}

		// If an existing target for this class already exists, quit.
		if (existingTarget) return;

		// Create the new Bounty Target and add it to the registry.
		let newTarget = BountyTarget.create(name, value, effect);

		if (newTarget) BountyTargets.push(newTarget);
	}

	void processRemoveMerchantBountyTargetCmd(HDCoreCommand cmd) {

		let name = cmd.getNameParam("name");

		forEach (target : BountyTargets) {
			if (target.targetCls == name) {
				BountyTargets.delete(BountyTargets.find(target));
				break;
			}
		}
	}

	void processClearMerchantBountyTargetsCmd(HDCoreCommand cmd) {
		BountyTargets.clear();
	}

	void processAddMerchantNonBountyBlacklistCmd(HDCoreCommand cmd) {
		addNonBountyBlacklist(cmd.getNameParam("name"));
	}

	void processRemoveMerchantNonBountyBlacklistCmd(HDCoreCommand cmd) {
		removeNonBountyBlacklist(cmd.getNameParam("name"));
	}

	void processClearMerchantNonBountyBlacklistCmd(HDCoreCommand cmd) {
		NonBountyBlacklist.clear();
	}

	void processAddMerchantSafeMapCmd(HDCoreCommand cmd) {
		addSafeMapName(cmd.getNameParam("name"));
	}

	void processRemoveMerchantSafeMapCmd(HDCoreCommand cmd) {
		removeSafeMapName(cmd.getNameParam("name"));
	}

	void processClearMerchantSafeMapsCmd(HDCoreCommand cmd) {
		SafeMapNames.clear();
	}

	void processNewMerchantSkinCmd(HDCoreCommand cmd) {

		HDCore.log('Merchant.MerchantHandler', LOGGING_DEBUG, "Processing New Merchant Skin Command: "..cmd.toString());

		// Get Skin ID
		let id = cmd.getNameParam("name");

		// Get remaining params
		let className = cmd.getNameParam("className", 'HDMerchant');
		let tag = cmd.getStringParam("tag", "$TAG_MERCHANT");
		let sprite = cmd.getNameParam("sprite", 'HOBM');
		let scaleX = cmd.getDoubleParam("scaleX", 1.0);
		let scaleY = cmd.getDoubleParam("scaleY", 1.0);
		let openState = cmd.getNameParam("openState", 'OpenMenu.Default');
		let closeState = cmd.getNameParam("closeState", 'SpawnLoop');
		let openSound = cmd.getNameParam("openSound");
		let closeSound = cmd.getNameParam("closeSound");

		vector2 scale = (scaleX, scaleY);

		HDMerchantSkin existingSkin;
		forEach (skin : Skins) {
			let currId = skin.skinId;

			if (currId != '' && id != '' && currId == id) {
				existingSkin = skin;
				break;
			}
		}

		if (existingSkin) return;

		let newskin = HDMerchantSkin.create(id, className, tag, sprite, scale, openState, openSound, closeState, closeSound);

		if (newSkin) skins.push(newSkin);
	}

	void processRemoveMerchantSkinCmd(HDCoreCommand cmd) {

		let name = cmd.getNameParam("name");

		forEach (skin : Skins) {
			if (skin.skinId == name) {
				Skins.delete(Skins.find(skin));
				break;
			}
		}
	}

	void processClearMerchantSkinsCmd(HDCoreCommand cmd) {
		Skins.clear();
	}

	void processNewMerchantStoreCmd(HDCoreCommand cmd) {

		HDCore.log('Merchant.MerchantHandler', LOGGING_DEBUG, "Processing New Merchant Store Command: "..cmd.toString());

		// Get Data Providers
		let typeParam = cmd.getParamValue("type");
		let enabledParam = cmd.getParamValue("enabled");
		let weightParam = cmd.getParamValue("weight");
		let skinsParam = cmd.getParamValue("skins");

		// Get Store Type
		let type = typeParam.getNameValue();

		// get remaining params
		let chance = cmd.getDoubleParam("chance", -1.0);
		let stockMult = cmd.getDoubleParam("stockMult", 1.0);
		let priceMult = cmd.getDoubleParam("priceMult", 1.0);

		// Look for existing store definitions
		MerchantStore existingStore;
		forEach (store : Stores) {
			let currType = store.type;

			if (currType != '' && type != '' && currType == type) {
				existingStore = store;
				break;
			}
		}

		// If an existing store for this type already exists, quit.
		if (existingStore) return;

		// Create the new store and add it to the registry.
		let newStore = MerchantStore.create(
			type,
			chance,
			stockMult,
			priceMult
		);

		HDCore.log('Merchant.MerchantHandler', LOGGING_DEBUG, type.." => "..skinsParam);

		// Parse out Skins Param
		if (skinsParam != null && skinsParam.getStringValue() != "") {

			Array<string> skinsArr;
			skinsArr.clear();

			let skinsFlags = skinsParam.getIntValue();
			if (skinsFlags > 0) {

				// Store the default Skin IDs
				name defaultSkins[10] = {
					'ResidentEvil',
					'Hobo',
					'Succubus',
					'Morshu',
					'WanderingTrader',
					'Daina1',
					'Daina2',
					'Daina3',
					'Daina4',
					'Nari1'
				};

				// If we've selected any skins for this store type, add them.
				for (let i = 0; i < defaultSkins.size(); i++) if (skinsFlags & 1 << i) skinsArr.push(defaultSkins[i]);

			} else {
				skinsParam.getStringValue().split(skinsArr, ",", TOK_SKIPEMPTY);
			}

			forEach(skin : skinsArr) {
				skin.stripLeftRight();
				newStore.addSkin(skin);
			}
		}

		if (newStore) {
			StoreTypes.addEntry(MerchantStoreTableEntry.create(typeParam, enabledParam, weightParam));

			stores.push(newStore);
		}
	}

	void processRemoveMerchantStoreCmd(HDCoreCommand cmd) {

		let type = cmd.getNameParam("type");

		forEach (store : Stores) {
			if (store.type == type) {
				Stores.delete(Stores.find(store));
				break;
			}
		}
	}

	void processClearMerchantStoresCmd(HDCoreCommand cmd) {
		StoreTypes.clearEntries();
		Stores.clear();
	}

	void processAddMerchantStoreSkinCmd(HDCoreCommand cmd) {

		HDCore.log('Merchant.MerchantHandler', LOGGING_DEBUG, "Processing Add Merchant Store Skin Command: "..cmd.toString());
				
		// Get Store Type
		let type = cmd.getNameParam("type");

		// Get Skin ID
		let skinId = cmd.getNameParam("skin");

		// Look for existing store definition
		MerchantStore existingStore;
		forEach (store : Stores) {
			let currType = store.type;

			if (currType != '' && type != '' && currType == type) {
				existingStore = store;
				break;
			}
		}

		// If an existing store for this type doesn't exist, quit.
		if (!existingStore) return;

		// Look for existing skin definition
		HDMerchantSkin existingSkin;
		forEach (skin : Skins) {
			let currId = skin.skinId;

			if (currId != '' && skinId != '' && currId == skinId) {
				existingSkin = skin;
				break;
			}
		}

		// If an existing skin for this ID doesn't exist, quit.
		if (!existingSkin) return;

		// Add the skin to the store if it isn't already.
		if (existingStore.skins.find(skinId) >= existingStore.skins.size()) existingStore.skins.push(skinId);
	}

	void processNewMerchantStoreCurrencyCmd(HDCoreCommand cmd) {

		HDCore.log('Merchant.MerchantHandler', LOGGING_DEBUG, "Processing New Merchant Store Currency Command: "..cmd.toString());

		// Get Currency name and check if it's valid
		let currency = cmd.getNameParam("name");
		Class<Inventory> currencyCls = currency;

		// If the currency's class doesn't exist, quit.
		if (!currencyCls) return;

		// get remaining params
		let icon = cmd.getStringParam("icon");
		let priceMult = cmd.getDoubleParam("priceMult", 1.0);

		// Look for existing currency definitions
		StoreCurrency existingCurrency;
		forEach (c : StoreCurrencies) {
			let currName = c.getCurrencyClass();

			if (currName != '' && currency != '' && currName == currency) {
				existingCurrency = c;
				break;
			}
		}

		// If an existing currency for this class already exists, quit.
		if (existingCurrency) return;

		// Create the new currency and add it to the registry.
		let newCurrency = StoreCurrency.create(currency, icon, priceMult);

		if (newCurrency) {
			if (cmd.getBoolParam("default")) {
				StoreCurrencies.insert(0, newCurrency);
			} else {
				StoreCurrencies.push(newCurrency);
			}
		}
	}

	void processRemoveMerchantStoreCurrencyCmd(HDCoreCommand cmd) {

		let currency = cmd.getNameParam("name");

		forEach (storeCurrency : StoreCurrencies) {
			if (storeCurrency.cls == currency) {
				StoreCurrencies.delete(StoreCurrencies.find(storeCurrency));
				break;
			}
		}
	}

	void processClearMerchantStoreCurrenciesCmd(HDCoreCommand cmd) {
		StoreCurrencies.clear();
	}

	void processNewMerchantStoreItemCmd(HDCoreCommand cmd) {

		HDCore.log('Merchant.MerchantHandler', LOGGING_DEBUG, "Processing New Merchant Store Item Command: "..cmd.toString());

		// Get Item name and check if it's valid
		let item = cmd.getNameParam("item");
		Class<Actor> itemCls = item;
		
		// If the item's class doesn't exist, quit.
		if (!itemCls) return;
		
		// Get Item type and check if it's valid
		let type = cmd.getNameParam("type");

		// get remaining params
		let chance = cmd.getDoubleParam("chance", -1.0);
		let category = cmd.getStringParam("category", type);
		let icon = cmd.getStringParam("icon");
		let displayName = cmd.getStringParam("displayName", item);
		let flavorText = cmd.getStringParam("flavorText");
		let baseAmount = cmd.getIntParam("amount", 1);
		let basePrice = cmd.getIntParam("basePrice", 1);
		let baseStoreAmount = cmd.getIntParam("storeAmount");

		StoreItem existingItem;
		forEach (i : StoreItems) {
			let itemName = i.getItem();

			if (itemName != '' && item != '' && itemName == item) {
				existingItem = i;
				break;
			}
		}

		// If an existing store item for this class already exists, quit.
		if (existingItem) return;

		// Create the new store item and add it to the registry.
		let newItem = StoreItem.create(
			type,
			chance,
			category,
			item,
			icon,
			displayName,
			flavorText,
			baseAmount,
			basePrice,
			baseStoreAmount
		);

		if (newItem) StoreItems.push(newitem);
	}

	void processRemoveMerchantStoreItemCmd(HDCoreCommand cmd) {

		let item = cmd.getNameParam("item");

		forEach (storeItem : StoreItems) {
			if (storeItem.getItem() == item) {
				StoreItems.delete(StoreItems.find(storeItem));
				break;
			}
		}
	}

	void processClearMerchantStoreItemsCmd(HDCoreCommand cmd) {
		StoreItems.clear();
	}

	void addNonBountyBlacklist(name bl) {
		if (bl && NonBountyBlacklist.find(bl) == NonBountyBlacklist.size()) NonBountyBlacklist.push(bl);
	}

	void removeNonBountyBlacklist(name bl) {
		if (NonBountyBlacklist.find(bl) < NonBountyBlacklist.size()) NonBountyBlacklist.delete(NonBountyBlacklist.find(bl));
	}

	void addSafeMapName(name mapName) {
		if (mapName && SafeMapNames.find(mapName) == SafeMapNames.size()) SafeMapNames.push(mapName);
	}

	void removeSafeMapName(name mapName) {
		if (SafeMapNames.find(mapName) < SafeMapNames.size()) SafeMapNames.delete(SafeMapNames.find(mapName));
	}

	override void afterProcessCommands() {
		if (HDCore.ShouldLog('Merchant.MerchantHandler', LOGGING_DEBUG)) {

			let msg = "Merchant Bounty Targets:\n";
			
			forEach (target : BountyTargets) msg = msg.." * "..target.toString().."\n";

			HDCore.Log('Merchant.MerchantHandler', LOGGING_DEBUG, msg);


			msg = "Merchant Safe Maps:\n";

			forEach (mapName : SafeMapNames) msg = msg.." * "..mapName.."\n";

			HDCore.Log('Merchant.MerchantHandler', LOGGING_DEBUG, msg);


			msg = "Merchant Skins:\n";

			forEach (skin : Skins) msg = msg.." * "..skin.toString().."\n";

			HDCore.Log('Merchant.MerchantHandler', LOGGING_DEBUG, msg);


			msg = "Merchant Currencies:\n";
			forEach (currency : StoreCurrencies) msg = msg.." * "..currency.toString().."\n";

			HDCore.Log('Merchant.MerchantHandler', LOGGING_DEBUG, msg);


			msg = "Merchant Stores:\n";

			forEach (store : Stores) msg = msg.." * "..store.toString().."\n";

			HDCore.Log('Merchant.MerchantHandler', LOGGING_DEBUG, msg);


			msg = "Merchant Store Items:\n";

			forEach (item : StoreItems) msg = msg.." * "..item.toString().."\n";

			HDCore.Log('Merchant.MerchantHandler', LOGGING_DEBUG, msg);
		}
	}

	HDMerchantSkin getMerchantSkin(name skinId) {
		forEach(skin : Skins) if (skin.skinId == skinId) return skin;

		return null;
	}

	override void NetworkProcess(ConsoleEvent e) {

		let plr = players[e.Player].mo;
		name eventName = e.name;

		switch (eventName) {
			case 'HDM_AssemblePokerGame': {
				AssembleGame(plr);

				break;
			}
			case 'HDMPlaceBet': {
				PlaceBet(CardPlayers[PlayerIndex], e.Args[0]);

				break;
			}
			case 'HDM_Fold': {
				ActionTimer = 0;

				CardPlayers[PlayerIndex].HasFolded = true;
				RotatePlayer();

				break;
			}
			case 'HDM_Check': {
				ActionTimer = 0;

				CardPlayers[PlayerIndex].HasChecked = true;
				CardPlayers[PlayerIndex].Player.A_StartSound("Poker/Check", 10, CHANF_UI, attenuation: 1.5);
				RotatePlayer();

				break;
			}
			default: {
				Array<string> ParsedName;
				e.name.Split(ParsedName, ":");

				if (ParsedName[0] ~== "HDM_BuyStuff") {

					forEach (store : Stores) {

						StoreItem item;
						forEach (storeItem : store.StoreItems) {

							if (storeItem.GetItem() == ParsedName[1]) {
								item = storeItem;
								break;
							}
						}
		
						if (item && plr) {

							class<Actor> ItemClass = item.GetItem();
							int Amount = item.GetAmount();
		
							StoreCurrency Currency = StoreCurrencies[e.Args[0]];
							int Price = StoreItem.GetAdjustedPrice(item, Currency);
		
							// If the price is too high, play failure sound and quit.
							if (Price > plr.CountInv(Currency.GetCurrencyClass())) {
								plr.A_StartSound("Merchant/BuyFailure", 15, CHANF_LOCAL | CHANF_UI);
								return;
							}

							// If the thing bought is a pickup or pickup giver, give to the player & dump the overflow
							// otherwise just dump the thing on the ground.
							if (!(ItemClass is 'HDPickup') || ItemClass is 'HDPickupGiver') {
								Actor a; bool success;

								[success, a] = plr.A_SpawnItemEx(
									ItemClass,
									6, 0, plr.height - 8,
									frandom(-1.0, 1.0), frandom(-1.0, 1.0), frandom(2.0, 5.0),
									0,
									SXF_NOCHECKPOSITION
								);

								if (success && a is 'Inventory') Inventory(a).Amount = amount;
							} else {
								class<Inventory> InvClass = (class<Inventory>)(ItemClass);
								int MaxGive = GetDefaultByType(InvClass).MaxAmount - plr.CountInv(InvClass);
								int MaxActualGive = min(Amount, MaxGive);

								// [Ace] Give what you can directly and drop the rest on the ground.
								HDF.give(plr, InvClass, MaxActualGive);
								Amount -= MaxActualGive;

								if (Amount > 0) {
									Actor a; bool success;

									[success, a] = plr.A_SpawnItemEx(
										InvClass,
										6, 0, plr.height - 8,
										frandom(-1.0, 1.0), frandom(-1.0, 1.0), frandom(2.0, 5.0),
										0,
										SXF_NOCHECKPOSITION
									);

									if (success) Inventory(a).Amount = Amount;
								}
							}

							// Take the currency from the player, play success sound, reduce stock
							plr.A_TakeInventory(Currency.GetCurrencyClass(), Price);
							plr.A_StartSound("Merchant/BuySuccess", 16, CHANF_LOCAL | CHANF_UI);
							item.StoreAmount--;

							// If there's none left, remove from the store.
							// TODO: Mark as disabled instead?
							if (item.StoreAmount <= 0) {
								store.StoreItems.Delete(store.StoreItems.Find(item));
								item.Destroy();
							}

							break;
						}
					}
				}

				break;
			}
		}
	}

	override void WorldLoaded(WorldEvent e) {

		super.worldLoaded(e);

		if (e.IsReopen) return;

		MoneyMode = hdm_moneymode == 3 ? random(0, 1) : hdm_moneymode;
		
		// Initialize the stores for this map
		for (int i = 0; i < Stores.Size(); ++i) InitStore(Stores[i].type);
		
		if (HDCore.ShouldLog('Merchant.MerchantHandler', LOGGING_DEBUG)) {
			let msg = "Merchant Stores:\n";

			forEach (store : Stores) {
				forEach (category : store.Categories) {
					msg = msg.." * "..category.." Items:\n";

					forEach (item : store.StoreItems) {
						if (item.GetCategory() == category) {
							msg = msg.."   * "..item.toString().."\n";
						}
					}
				}
			}

			HDCore.Log('Merchant.MerchantHandler', LOGGING_DEBUG, msg);
		}

		Array<MerchantStore> AvailableStores;
		AvailableStores.copy(Stores);

		int mCount = Stores.Size();
		int MerchantsLeft = min(mCount, level.MapName ~== "LOTSAGUN" ? mCount : CVar.GetCVar('hdm_maxmerchants').GetInt());

		Array<Sector> dedicatedMerchantSectors;
		Array<Sector> dedicatedSlotSectors;
		Array<Sector> secretSectors;

		foreach (sec : level.sectors) {
			if (sec.GetUDMFInt('user_merchantsector') == 1) {
				dedicatedMerchantSectors.Push(sec);
				continue;
			}

			if (sec.GetUDMFInt('user_slotmachinesector') == 1) {
				dedicatedSlotSectors.Push(sec);
				continue;
			}

			// [Ace] Secret sectors that are already dedicated don't count.
			
			// NOTE I: Don't spawn stuff in low sectors to prevent softlocking. You can climb crystals, but not if you slam your head into the ceiling doing so.
			if (
				sec.IsSecret()
				&& dedicatedMerchantSectors.Find(sec) == dedicatedMerchantSectors.Size()
				&& dedicatedSlotSectors.Find(sec) == dedicatedSlotSectors.Size()
			) {
				Vector2 center = sec.centerspot;
				double secHeight = abs(sec.floorplane.ZAtPoint(center) - sec.ceilingplane.ZAtPoint(center));

				if (secHeight < 64) continue;

				secretSectors.Push(sec);
			}
		}

		int validSectorCount = secretSectors.Size();
		if (validSectorCount == 0 && dedicatedMerchantSectors.Size() == 0 && dedicatedSlotSectors.Size() == 0) return;

		// [Ace] Sort sectors by size in ascending order. Spawn merchants in smaller sectors first. Tiberium is the opposite - it prioritizes bigger sectors first.
		for (int i = 0; i < secretSectors.Size() - 1; ++i) {
			for (int j = i + 1; j < secretSectors.Size(); ++j) {
				if (HDCore.GetSectorSize(secretSectors[i]) > HDCore.GetSectorSize(secretSectors[j])) {
					let swap = secretSectors[i];
					secretSectors[i] = secretSectors[j];
					secretSectors[j] = swap;
				}
			}
		}

		// ------------------------------------------------------------------------------------------------------------------------
		//
		// BITCHES DON'T KNOW 'BOUT MY TIBERIUM DEPOSITS.
		// 
		// ------------------------------------------------------------------------------------------------------------------------

		// [Ace] Spawn the crystals first, and only then bother with the merchants.
		if (MoneyMode == 0 || MoneyMode == 2) {

			for (int i = secretSectors.Size() - 1; i >= 0; --i) {
				if (hdm_debug || HDCore.GetRandomInt(1, 100, hdc_random_mode) <= HDCore.GetscaledChanceInt(5, 40, acl_spawnscale_min, acl_spawnscale_max)) {
					SpawnedTiberium = true;

					SpawnCrystals(secretSectors[i]);
					secretSectors.Delete(i);

					if (hdm_debug) break;
				}
			}
		}

		// ------------------------------------------------------------------------------------------------------------------------
		//
		//	MERCHANT SPAWNING
		// 
		// ------------------------------------------------------------------------------------------------------------------------

		// [Ace] Some boilerplate because I can't make local functions and the workaround is ironically worse.
		foreach (sec : dedicatedMerchantSectors) {

			let param = "";
			foreach (store : AvailableStores) param = param..","..store.type;
        
			Dictionary params = Dictionary.create();
			params.insert("availableStores", param);

			HDCore.log('Merchant.MerchantHandler', LOGGING_DEBUG, "Dedicated Sector - AvailableStores: "..param);

			let predicateFn = MerchantStoreTableEntry.shouldGetEntry;
			let weightedRandomEntry = StoreTypes.getRandomEntry(predicateFn, params);
			let entry = MerchantStoreTableEntry(weightedRandomEntry);

			let store = GetStore(entry.getName());
			if (TrySpawnMerchant(sec, store)) {
				AvailableStores.Delete(AvailableStores.Find(store));
	
				if (--MerchantsLeft <= 0) break;
			}
		}

		if (MerchantsLeft && AvailableStores.Size()) {
			foreach (sec : secretSectors) {
				if (HDCore.getRandomInt(1, 100, hdc_random_mode) < 70) {

					let param = "";
					foreach (store : AvailableStores) param = param..","..store.type;
        
					Dictionary params = Dictionary.create();
					params.insert("availableStores", param);

					HDCore.log('Merchant.MerchantHandler', LOGGING_DEBUG, "Secret Sector - AvailableStores: "..param);

					let predicateFn = MerchantStoreTableEntry.shouldGetEntry;
					let weightedRandomEntry = StoreTypes.getRandomEntry(predicateFn, params);
					let entry = MerchantStoreTableEntry(weightedRandomEntry);

					let store = GetStore(entry.getName());
					if (TrySpawnMerchant(sec, store)) {
						AvailableStores.Delete(AvailableStores.Find(store));

						if (--MerchantsLeft <= 0) break;
					}
				}
			}
		}

		// ------------------------------------------------------------------------------------------------------------------------
		//
		// SLOT MACHINE SPAWNING
		// 
		// ------------------------------------------------------------------------------------------------------------------------

		bool spawnedMachine = false;
		for (int i = 0; i < dedicatedSlotSectors.Size(); i++) {

			Vector3 spawnPos = (dedicatedSlotSectors[i].centerspot, dedicatedSlotSectors[i].centerFloor());

			Actor a = Actor.Spawn('MerchantSlotMachine', spawnPos);
			a.angle = dedicatedSlotSectors[i].GetUDMFInt('user_slotmachineangle');
			spawnedMachine = true;

			if (HDCore.ShouldLog('Merchant.MerchantHandler', LOGGING_DEBUG)) HDCore.Log(
				'Merchant.MerchantHandler', LOGGING_DEBUG, String.format(
					"Spawned %s. Sector @\c[DarkGray]%i\c-, \c[DarkGray]%i\c-.",
					a.GetTag(), spawnPos.x, spawnPos.y
				)
			);
		}

		if (!spawnedMachine && hdm_enableslots) {

			for (int i = 0; i < secretSectors.Size(); i++) {

				Vector3 spawnPos = (secretSectors[i].centerspot, secretSectors[i].floorplane.ZAtPoint(secretSectors[i].centerspot));
				if (!level.IsPointInLevel(spawnPos) || HDCore.GetRandomInt(1, 100, hdc_random_mode) <= 20) continue;

				Actor a = Actor.Spawn('MerchantSlotMachine', spawnPos);
				a.angle = secretSectors[i].GetUDMFInt('user_slotmachineangle');
				secretSectors.Delete(i--);

				if (HDCore.ShouldLog('Merchant.MerchantHandler', LOGGING_DEBUG)) HDCore.Log(
					'Merchant.MerchantHandler', LOGGING_DEBUG, String.format(
						"Spawned %s. Sector @\c[DarkGray]%i\c-, \c[DarkGray]%i\c-.",
						a.GetTag(), spawnPos.x, spawnPos.y
					)
				);

				break;
			}
		}
	}

	override void WorldUnloaded(WorldEvent e) {

		if (!players[Net_Arbitrator].mo) return;

		forEach (p : PLAYERS) if (p.mo) p.mo.A_TakeInventory("HDMerchantBody");
	}

	override void WorldTick() {

		if (GameInProgress) PokerTick();

		// Initialize Bounty Target(s) Selection
		if (level.mapTime == hdc_prespawn_threshold && (MoneyMode == 1 || (MoneyMode == 2 && !SpawnedTiberium))) {
			int count = 1;
			for (int i = 0; i < 2; ++i) {

				if (random() <= HDCore.GetscaledChanceInt(0, 64, 5, 15 + (5 * i))) {
					count++;
				} else {
					break;
				}
			}

			InitBountyTargets(count);
		}
	}

	override void WorldThingDied(WorldEvent e) {

		// If we're still initializing the level,
		// don't "pre-drop" money from already dead mobs.
		if (HDCore.isPreSpawn()) return;

		// If thing is an item (?) and is owned (?) quit.
		if (e.thing is 'Inventory' && Inventory(e.thing).owner && e.thing.pos == (0, 0, 0)) return;

		// If thing has an invalid pos, quit.
		if (e.thing.pos == (-Double.NaN, -Double.NaN, -Double.NaN)) return;

		// If thing isn't some sort of HDMobBase, quit.
		// TODO: Expand to whitelist
		if (!(e.thing is 'HDMobBase')) return;

		// If thing is blacklisted, quit.
		forEach (bl : NonBountyBlacklist) if (e.thing is bl) return;

		// If the Non-Bounty Drop Ratio is a positive value,
		// and the thing hasn't died/dropped yet, drop currency.
		let mob = HDMobBase(e.thing);
		if (hdm_nonbounty_dropratio > 0 && !mob.bHASDROPPED) DropCurrency(mob);
	}

	private bool TrySpawnMerchant(Sector sec, MerchantStore store) {

		// If the center of the sector isn't the same sector, quit.
		if (Level.pointInSector(sec.centerspot) != sec) return false;

		Vector3 spawnPos = (sec.centerspot, sec.floorplane.ZAtPoint(sec.centerspot));

		// Create a list to store the intended skins
		Array<HDMerchantSkin> AvailableSkins;
		AvailableSkins.clear();

		HDCore.Log('Merchant.MerchantHandler', LOGGING_DEBUG, "Getting available skins from "..store.type.." Store => "..store.toString());

		forEach(skinName : store.skins) {
			let skin = getMerchantSkin(skinName);

			if (skin) {
				HDCore.Log('Merchant.MerchantHandler', LOGGING_TRACE, store.type.." Merchant adding "..skinName.." skin => "..skin.toString());
	
				if (AvailableSkins.find(skin) == AvailableSkins.size()) AvailableSkins.push(skin);
			}
		}

		name merchantClass = 'HDMerchant';
		HDMerchantSkin selectedSkin = null;

		if (AvailableSkins.size()) {
			selectedSkin = AvailableSkins[HDCore.getRandomInt(0, AvailableSkins.Size() - 1, hdc_random_mode)];

			// If the skin defines a custom child class of a merchant, replace the intended actor class with that.
			if (
				HDCore.CheckClassExists(selectedSkin.className)
				&& HDCore.IsChildClass((Class<Object>)(selectedSkin.className), 'HDMerchant', allowSameCls: false)
			) {
				HDCore.Log('Merchant.MerchantHandler', LOGGING_DEBUG, store.type.." Merchant has custom class '"..selectedSkin.className.."'");
				merchantClass = selectedSkin.className;
			}
		}


		// Attempt to spawn the Merchant
		let a = HDMerchant(Actor.Spawn(merchantClass, spawnPos));

		// If it spawned successfully, set the relevant information
		if (a) {
			a.angle = sec.GetUDMFInt('user_merchantangle');
			a.storeType = store.type;
			
			if (selectedSkin) a.selectedSkin = selectedSkin;

			if (HDCore.ShouldLog('Merchant.MerchantHandler', LOGGING_DEBUG)) HDCore.Log(
				'Merchant.MerchantHandler', LOGGING_DEBUG, String.format(
					"Spawned %s. Sector @\c[DarkGray]%i\c-, \c[DarkGray]%i\c-.",
					a.GetTag(), spawnPos.x, spawnPos.y
				)
			);

			return true;
		}

		return false;
	}

	private void DropCurrency(HDMobBase mob) {

		HDCore.log('Merchant.MerchantHandler', LOGGING_DEBUG, mob.getClassName().." Dropping Non-Bounty Cash...");

		// Get the raw amount of currency to drop
		let bounty = GetBounty(mob);
		let healthamt = mob.getspawnhealth() + (mob.maxshields / 2);
		let maxAmount = random(min(bounty, healthamt), max(bounty, healthamt)) * hdm_nonbounty_dropratio;
		let amount = random(0, maxAmount);

		if (hdm_nonbounty_directdeposit) {
			HDCore.log('Merchant.MerchantHandler', LOGGING_DEBUG, "Depositing "..amount.."x MercenaryBucks into Players' Inventories...");

			// Genericfiredemon: Code taken from line 263 of Bounty.zsc and modified for basic cash.
			HDCore.GiveToPlayers('MercenaryBucks', amount);
		} else if (amount > 0 && amount < 250) {
			HDCore.log('Merchant.MerchantHandler', LOGGING_DEBUG, "Dropping Wallet with "..amount.."x MercenaryBucks onto ground...");

			let wallet = HDWallet(mob.DropNewItem('HDWallet'));

			if (wallet) wallet.add("MercenaryBucks,"..amount);
		} else {
			HDCore.log('Merchant.MerchantHandler', LOGGING_DEBUG, "Dropping "..amount.."x MercenaryBucks onto ground...");

			while (amount > 0) {

				if (amount >= 2000) {
					mob.DropNewItem('BigGem');
					amount -= 2000;
				} else if (amount >= 1000) {
					mob.DropNewItem('SmallGem');
					amount -= 1000;
				} else if (amount >= 750) {
					mob.DropNewItem('BigCoin');
					amount -= 750;
				} else if (amount >= 500) {
					mob.DropNewItem('MediumCoin');
					amount -= 500;
				} else if (amount >= 250) {
					mob.DropNewItem('SmallCoin');
					amount -= 250;
				// } else if (amount >= 100) {
				// 	mob.DropNewItem('MercenaryBucks100');
				// 	amount -= 100;
				// } else if (amount >= 25) {
				// 	mob.DropNewItem('MercenaryBucks25');
				// 	amount -= 25;
				// } else {
				// 	mob.DropNewItem('MercenaryBucks1');
				// 	amount -= 1;
				}
			}
		}
	}
}
